# --- Serveur ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Base de données (PostgreSQL) ---
DATABASE_URL=postgres://tanjakai:tanjakai@localhost:5432/tanjakai
DB_POOL_MAX=10

# --- Authentification ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacer-par-une-longue-valeur-aleatoire-de-48-caracteres-minimum
JWT_EXPIRES_IN=15m
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Requêtes d'authentification sensibles (connexion, second facteur, mot de passe) par IP et par 15 minutes
LOGIN_RATE_LIMIT=20
# DEV UNIQUEMENT : saute le second facteur (direction / administrateur)
DEV_SKIP_2FA=false

# --- Limitation de débit ---
RATE_LIMIT_PER_MIN=120

# --- Jeu de données de développement (npm run seed) ---
SEED_PASSWORD=ChangeMe!2026Tj

# --- Saisie ---
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5
VARIATION_ANORMALE_PCT=50


# --- Sécurité des sessions et second facteur ---
# Déconnexion automatique : une session inactive plus longtemps que cette durée ne peut plus être renouvelée
SESSION_IDLE_MINUTES=30
# Durée maximale absolue d'une session, même en activité continue
SESSION_MAX_HOURS=12
TOTP_ISSUER=TANJAKAI
# Clé de chiffrement des secrets TOTP (64 caractères hexadécimaux). Générer :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# À défaut, elle est dérivée de JWT_SECRET (changer JWT_SECRET obligerait alors à réenrôler les comptes).
TOTP_ENC_KEY=


# --- Synthèses assistées (OpenRouter, appelé uniquement par le serveur) ---
# Sans clé, l'application fonctionne en mode dégradé : chiffres produits, sans commentaire rédigé.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Dépense maximale par mois civil (dollars). Au-delà, mode dégradé jusqu'au mois suivant.
OPENROUTER_PLAFOND_MENSUEL=5
OPENROUTER_MAX_TOKENS=900
OPENROUTER_TIMEOUT_MS=30000
